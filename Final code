void handleRoot() {

  updateGPS();

  server.send(
    200,
    "text/html",
    htmlPage()
  );
}

void handleScan() {

  scanWiFi();

  server.sendHeader(
    "Location",
    "/"
  );

  server.send(
    302,
    "text/plain",
    ""
  );
}

void handleRecord() {

  recordAllNetworks();

  server.sendHeader(
    "Location",
    "/"
  );

  server.send(
    302,
    "text/plain",
    ""
  );
}

void handleClear() {

  if (SD.exists("/rf_data.csv")) {

    SD.remove("/rf_data.csv");

    snapshotNumber = 0;

    Serial.println("Data cleared!");
  }

  server.sendHeader(
    "Location",
    "/"
  );

  server.send(
    302,
    "text/plain",
    ""
  );
}


void handleButton1() {

  if (digitalRead(BUTTON1) != LOW)
    return;

  unsigned long start = millis();

  while (digitalRead(BUTTON1) == LOW) {
    delay(10);
  }

  unsigned long duration = millis() - start;

  if (duration >= 1000) {

    // Long press
    Serial.println("BUTTON 1 LONG PRESS");

    digitalWrite(LED_PIN, HIGH);

    recordAllNetworks();

    digitalWrite(LED_PIN, LOW);

  } else {

    // Short press
    Serial.println("BUTTON 1 SHORT PRESS");

    if (networkCount > 0) {

      selectedNetwork++;

      if (selectedNetwork >= networkCount)
        selectedNetwork = 0;

      showMainScreen();
    }
  }
}


void handleButton2() {

  if (digitalRead(BUTTON2) != LOW)
    return;

  unsigned long start = millis();

  while (digitalRead(BUTTON2) == LOW) {
    delay(10);
  }

  unsigned long duration = millis() - start;

  if (duration >= 1000) {

    Serial.println("BUTTON 2 LONG PRESS");

    display.clearDisplay();

    display.setTextColor(SSD1306_WHITE);

    display.setTextSize(1);

    display.setCursor(0, 0);
    display.println("WEB DASHBOARD");

    display.drawLine(0, 10, 127, 10, SSD1306_WHITE);

    display.setCursor(0, 25);
    display.println("Dashboard ready");

    display.setCursor(0, 40);
    display.println("Open:");

    display.setCursor(0, 52);
    display.println("192.168.4.1");

    display.display();

    delay(2000);

    showMainScreen();

  } else {

    Serial.println("BUTTON 2 SHORT PRESS");

    digitalWrite(LED_PIN, HIGH);

    scanWiFi();

    digitalWrite(LED_PIN, LOW);
  }
}


void setup() {

  Serial.begin(115200);

  delay(1000);

  Serial.println();
  Serial.println("================================");
  Serial.println("     RF SIGNAL MAPPER");
  Serial.println("================================");

  // Buttons
  pinMode(BUTTON1, INPUT_PULLUP);
  pinMode(BUTTON2, INPUT_PULLUP);

  // LED
  pinMode(LED_PIN, OUTPUT);

  digitalWrite(LED_PIN, LOW);

  // OLED
  Wire.begin(OLED_SDA, OLED_SCL);

  if (!display.begin(
        SSD1306_SWITCHCAPVCC,
        0x3C
      )) {

    Serial.println("OLED NOT FOUND!");

  } else {

    Serial.println("OLED INIT SUCCESS!");

    display.clearDisplay();

    display.setTextColor(SSD1306_WHITE);

    display.setTextSize(1);

    display.setCursor(15, 5);
    display.println("RF SIGNAL MAPPER");

    display.setCursor(30, 25);
    display.println("Wi-Fi Monitor");

    display.setCursor(40, 45);
    display.println("Starting...");

    display.display();
  }

  // GPS
  GPSserial.begin(
    9600,
    SERIAL_8N1,
    GPS_RX,
    GPS_TX
  );

  Serial.println("GPS SERIAL STARTED");

  // SD
  spi.begin(
    SD_SCK,
    SD_MISO,
    SD_MOSI,
    SD_CS
  );

  if (SD.begin(SD_CS, spi)) {

    Serial.println("SD CARD SUCCESS!");

  } else {

    Serial.println("SD CARD FAILED!");
  }

  // Wi-Fi Access Point
  WiFi.mode(WIFI_AP_STA);

  WiFi.softAP(
    "RF_MAPPER",
    "12345678"
  );

  Serial.println("Wi-Fi AP started");

  Serial.print("Dashboard: ");
  Serial.println(WiFi.softAPIP());

  // Web routes
  server.on("/", handleRoot);
  server.on("/scan", handleScan);
  server.on("/record", handleRecord);
  server.on("/clear", handleClear);

  server.begin();

  Serial.println("Web server started");

  delay(1500);

  scanWiFi();

  lastScan = millis();
}


void loop() {

  // GPS
  updateGPS();

  // Web dashboard
  server.handleClient();

  // Buttons
  handleButton1();
  handleButton2();

  // Automatic Wi-Fi scan every 30 seconds
  if (millis() - lastScan >= 30000) {

    scanWiFi();

    lastScan = millis();
  }

  delay(10);
}
