
#include <WiFi.h>
#include <WebServer.h>
#include <Wire.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>
#include <TinyGPSPlus.h>
#include <SPI.h>
#include <SD.h>

#define OLED_SDA 21
#define OLED_SCL 22

#define GPS_RX 16
#define GPS_TX 17

#define SD_CS   5
#define SD_SCK  18
#define SD_MISO 19
#define SD_MOSI 23

#define BUTTON1 25
#define BUTTON2 27

#define LED_PIN 26

#define SCREEN_WIDTH 128
#define SCREEN_HEIGHT 64

Adafruit_SSD1306 display(
  SCREEN_WIDTH,
  SCREEN_HEIGHT,
  &Wire,
  -1
);

TinyGPSPlus gps;
HardwareSerial GPSserial(2);

WebServer server(80);

SPIClass spi = SPIClass(VSPI);

int networkCount = 0;
int selectedNetwork = 0;

String networkSSID[50];
int networkRSSI[50];
int networkChannel[50];

int snapshotNumber = 0;

unsigned long lastScan = 0;

bool gpsFix = false;
double latitude = 0;
double longitude = 0;

String signalQuality(int rssi) {

  if (rssi >= -50)
    return "EXCELLENT";

  if (rssi >= -60)
    return "GOOD";

  if (rssi >= -70)
    return "FAIR";

  if (rssi >= -80)
    return "WEAK";

  return "VERY WEAK";
}

void updateGPS() {

  while (GPSserial.available()) {
    gps.encode(GPSserial.read());
  }

  if (gps.location.isValid()) {

    gpsFix = true;

    latitude = gps.location.lat();
    longitude = gps.location.lng();

  } else {

    gpsFix = false;
  }
}


void showMainScreen() {

  display.clearDisplay();

  display.setTextColor(SSD1306_WHITE);

  display.setTextSize(1);

  display.setCursor(0, 0);
  display.println("RF SIGNAL MAPPER");

  display.drawLine(0, 10, 127, 10, SSD1306_WHITE);

  if (networkCount > 0) {

    display.setCursor(0, 16);

    String ssid = networkSSID[selectedNetwork];

    if (ssid.length() > 20)
      ssid = ssid.substring(0, 20);

    display.println(ssid);

    display.setCursor(0, 30);

    display.print("RSSI: ");
    display.print(networkRSSI[selectedNetwork]);
    display.println(" dBm");

    display.setCursor(0, 43);

    display.print("CH: ");
    display.print(networkChannel[selectedNetwork]);

    display.print(" ");
    display.println(
      signalQuality(networkRSSI[selectedNetwork])
    );

    display.setCursor(0, 56);

    display.print("Network ");
    display.print(selectedNetwork + 1);
    display.print("/");
    display.println(networkCount);

  } else {

    display.setCursor(0, 28);
    display.println("No networks found");
  }

  display.display();
}


void showScanningScreen() {

  display.clearDisplay();

  display.setTextColor(SSD1306_WHITE);

  display.setTextSize(1);

  display.setCursor(0, 0);
  display.println("RF SIGNAL MAPPER");

  display.drawLine(0, 10, 127, 10, SSD1306_WHITE);

  display.setCursor(15, 25);
  display.println("Scanning Wi-Fi");

  display.setCursor(25, 42);
  display.println("Please wait...");

  display.display();
}


void scanWiFi() {

  Serial.println();
  Serial.println("Scanning Wi-Fi...");

  showScanningScreen();

  WiFi.mode(WIFI_AP_STA);

  WiFi.scanDelete();

  int count = WiFi.scanNetworks(false, true);

  if (count < 0) {

    Serial.println("Scan failed!");

    networkCount = 0;

    showMainScreen();

    return;
  }

  networkCount = min(count, 50);

  Serial.print("Networks found: ");
  Serial.println(networkCount);

  for (int i = 0; i < networkCount; i++) {

    networkSSID[i] = WiFi.SSID(i);
    networkRSSI[i] = WiFi.RSSI(i);
    networkChannel[i] = WiFi.channel(i);

    Serial.print(i + 1);
    Serial.print(": ");

    Serial.print(networkSSID[i]);

    Serial.print(" | RSSI: ");

    Serial.print(networkRSSI[i]);

    Serial.print(" | CH: ");

    Serial.println(networkChannel[i]);
  }

  selectedNetwork = 0;

  WiFi.scanDelete();

  lastScan = millis();

  showMainScreen();
}


void saveRecord(
  String ssid,
  int rssi,
  int channel
) {

  Serial.print("Saving: ");
  Serial.print(ssid);

  Serial.print(" | ");
  Serial.print(rssi);

  Serial.print(" dBm | CH ");
  Serial.println(channel);
}


void recordAllNetworks() {

  if (networkCount == 0) {

    Serial.println("No networks to record!");

    return;
  }

  snapshotNumber++;

  display.clearDisplay();

  display.setTextColor(SSD1306_WHITE);

  display.setTextSize(1);

  display.setCursor(0, 0);
  display.println("RECORDING DATA");

  display.drawLine(0, 10, 127, 10, SSD1306_WHITE);

  display.setCursor(0, 22);

  display.print("Snapshot #");
  display.println(snapshotNumber);

  display.setCursor(0, 36);

  display.print(networkCount);
  display.println(" networks");

  display.setCursor(0, 50);

  display.println("Saving...");

  display.display();

  updateGPS();

  // Open SD file
  File file = SD.open("/rf_data.csv", FILE_APPEND);

  if (!file) {

    Serial.println("SD file open failed!");

  } else {

    // Header only if file is empty
    if (file.size() == 0) {

      file.println(
        "Snapshot,SSID,RSSI,Channel,Latitude,Longitude"
      );
    }

    for (int i = 0; i < networkCount; i++) {

      file.print(snapshotNumber);
      file.print(",");

      file.print(networkSSID[i]);
      file.print(",");

      file.print(networkRSSI[i]);
      file.print(",");

      file.print(networkChannel[i]);
      file.print(",");

      if (gpsFix)
        file.print(latitude, 6);

      file.print(",");

      if (gpsFix)
        file.print(longitude, 6);

      file.println();

      saveRecord(
        networkSSID[i],
        networkRSSI[i],
        networkChannel[i]
      );
    }

    file.close();

    Serial.println("Saved to SD!");
  }

  display.clearDisplay();

  display.setTextColor(SSD1306_WHITE);

  display.setTextSize(1);

  display.setCursor(0, 0);
  display.println("RECORD COMPLETE");

  display.drawLine(0, 10, 127, 10, SSD1306_WHITE);

  display.setCursor(0, 25);

  display.print(networkCount);
  display.println(" networks");

  display.setCursor(0, 40);

  display.print("Snapshot #");
  display.println(snapshotNumber);

  display.setCursor(0, 54);

  if (SD.exists("/rf_data.csv"))
    display.println("Saved to SD");
  else
    display.println("Memory saved");

  display.display();

  delay(1500);

  showMainScreen();
}


